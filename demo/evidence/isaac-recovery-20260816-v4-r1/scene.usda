        def "Load0"
        {
            def Cube "Pallet" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.42, 0.24, 0.09)]
                double size = 1
                float3 xformOp:scale = (1, 0.75, 0.12)
                double3 xformOp:translate = (6.4, 1.02, 0.12)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }


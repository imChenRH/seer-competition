        token visibility = "invisible"
        double3 xformOp:translate = (3.15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "FallenBoxA" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.78, 0.16, 0.12)]
            double size = 1
            float3 xformOp:scale = (0.85, 0.7, 0.85)
            double3 xformOp:translate = (0, 0, 0.43)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "FallenBoxB" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.92, 0.42, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.65, 0.65, 0.65)
            double3 xformOp:translate = (0.35, 0.3, 0.32)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def "Lights"

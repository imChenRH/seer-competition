            color3f[] primvars:displayColor = [(0.92, 0.42, 0.08)]
            double size = 1
            float3 xformOp:scale = (0.65, 0.65, 0.65)
            double3 xformOp:translate = (0.35, 0.3, 0.32)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }


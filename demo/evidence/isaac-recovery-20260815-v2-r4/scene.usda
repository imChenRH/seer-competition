    def Camera "DemoCamera" (
        prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
        append apiSchemas = ["OmniSensorAPI"]
    )
    {
        token cameraProjectionType = "pinhole"
        float4[] clippingPlanes = []
        float2 clippingRange = (0.1, 1000)
        string crossCameraReferenceName
        float exposure:fStop = 5
        float exposure:responsivity = 1.1026709
        float exposure:time = 0.02
        float focalLength = 30
        float focusDistance = 400
        float fStop = 0
        float fthetaCx = 970.94244
        float fthetaCy = 600.3748
        float fthetaHeight = 1216
        float fthetaMaxFov = 200
        float fthetaPolyA = 0
        float fthetaPolyB = 0.00245
        float fthetaPolyC = 0
        float fthetaPolyD = 0
        float fthetaPolyE = 0
        float fthetaPolyF = 0
        float fthetaWidth = 1936
        float horizontalAperture = 20.955
        float horizontalApertureOffset = 0
        string omni:sensor:marketName = ""
        string omni:sensor:modelName = ""
        string omni:sensor:modelVendor = ""
        string omni:sensor:modelVersion = ""
        float omni:sensor:tickRate = 0
        float omni_col_sensor_col_tickRate
        float openCVFx = 731.7879
        float openCVFy = 731.7879
        float p0 = -0.00037
        float p1 = -0.00074
        token projection = "perspective"
        uniform token purpose = "default"
        float s0 = -0.00058
        float s1 = -0.00022
        float s2 = 0.00019
        float s3 = -0.0002
        double shutter:close = 0
        double shutter:open = 0
        uniform token stereoRole = "mono"
        float verticalApertureOffset = 0
        float3 xformOp:rotateXYZ = (54.69773, 1.9083329e-14, -122.57406)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-14, 0.5, 6.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

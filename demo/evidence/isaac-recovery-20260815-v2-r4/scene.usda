    def Xform "BackgroundLoads" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/PhysicsMaterials/OfficialCardboard>
        float3 xformOp:rotateXYZ = (0, 0, 8)
        double3 xformOp:translate = (0.5, 1.4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

        def "Load0"
        {
            def Cube "Pallet" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.42, 0.24, 0.09)]
                double size = 1
                float3 xformOp:scale = (1, 0.75, 0.12)
                double3 xformOp:translate = (5.15, 0.82, 0.12)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Cargo" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.35, 0.55, 0.72)]
                double size = 1
                float3 xformOp:scale = (0.8, 0.6, 0.75)
                double3 xformOp:translate = (5.15, 0.82, 0.55)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def "Load1"
        {
            def Cube "Pallet" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.42, 0.24, 0.09)]
                double size = 1
                float3 xformOp:scale = (1, 0.75, 0.12)
                double3 xformOp:translate = (5.15, -0.82, 0.12)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "Cargo" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.35, 0.55, 0.72)]
                double size = 1
                float3 xformOp:scale = (0.8, 0.6, 0.75)
                double3 xformOp:translate = (5.15, -0.82, 0.55)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

    def Xform "Obstacle"
    {
        token visibility = "invisible"
        double3 xformOp:translate = (2.9625320646550457, 1.9358164386962518, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "FallenBoxA"
        {
            color3f[] primvars:displayColor = [(0.78, 0.16, 0.12)]
            double size = 1
            float3 xformOp:scale = (0.85, 0.7, 0.85)
            double3 xformOp:translate = (0, 0, 0.43)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
